# Security headers for the static site, replacing the ones the Java service used to set.
# Cloudflare Pages applies these to every matching response.
#
# On the Content-Security-Policy below: it is verified against the running app — charts render
# and pdf.js starts its worker under it. 'unsafe-inline' appears in style-src only because
# Recharts sets inline styles on the SVG it generates; no inline script is permitted.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Hashed asset filenames are immutable, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html is not hashed and must never be cached, or a deploy leaves browsers pointing at
# bundles that no longer exist.
/index.html
  Cache-Control: no-cache, must-revalidate
